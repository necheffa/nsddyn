/system script add name=nsddynrosc comment="RouterOS client for nsddyn" policy="test" source={
    :local VERSION "0.2.2-p00-dev"
    :local SERVER "www.example.com:8080"
    :local IPADDR [ :put ([/tool fetch url="https://api.ipify.org/" output=user as-value ]->"data") ]
    :local PASSWD password
    :local USERNAME alex
    :local HOSTS "[ \"host1\", \"host2\" ]"
    :local REQUEST "{ \"password\": \"$PASSWD\", \"username\": \"$USERNAME\", \"hostnames\": $HOSTS, \"version\": \"$VERSION\", \"ipaddr\": \"$IPADDR\" }"

    /tool fetch url="https://$SERVER/api/dynupd" http-method=post http-header-field="content-type: application/json" http-data="$REQUEST" output=user as-value
}
